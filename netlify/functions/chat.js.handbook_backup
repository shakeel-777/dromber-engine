function sanitizeLlmReply(text) {
  if (!text) return "";
  let cleaned = text.replace(/<think>[\s\S]*?<\/think>/gi, "");
  cleaned = cleaned.replace(/<thought>[\s\S]*?<\/thought>/gi, "");

  const formulateMatch = cleaned.match(/(?:\*\*Formulate Response:\*\*|\*\*Final Response:\*\*|\*\*Response:\*\*|\*\*Customer Response:\*\*)[^"]*"([^"]{20,})"/i);
  if (formulateMatch && formulateMatch[1]) {
    return formulateMatch[1].trim();
  }

  const sectionMatch = cleaned.match(/(?:\*\*Final Response:\*\*|\*\*Customer Response:\*\*|\*\*Response:\*\*|\*\*Reply:\*\*)\s*([^\n][\s\S]*)/i);
  if (sectionMatch && sectionMatch[1]) {
    return sectionMatch[1].trim();
  }

  if (/^\s*(?:1\.|\*|-)?\s*\*\*(?:Analyze|Analysis|Thinking|Reasoning|Check Guidelines)/i.test(cleaned)) {
    const quotes = [...cleaned.matchAll(/"([^"]{30,})"/g)];
    if (quotes.length > 0) {
      return quotes[quotes.length - 1][1].trim();
    }
  }

  if (cleaned.toLowerCase().includes("thinking process")) {
    const parts = cleaned.split(/\n\n(?=[A-Z0-9#•*])/);
    if (parts.length > 1 && parts[0].toLowerCase().includes("thinking process")) {
      cleaned = parts.slice(1).join("\n\n");
    }
  }

  return cleaned.trim();
}

exports.handler = async function(event, context) {
  const corsHeaders = {
    'Content-Type': 'application/json',
    'Access-Control-Allow-Origin': '*',
    'Access-Control-Allow-Headers': 'Content-Type',
    'Access-Control-Allow-Methods': 'POST, OPTIONS'
  };

  if (event.httpMethod === 'OPTIONS') {
    return {
      statusCode: 204,
      headers: corsHeaders,
      body: ''
    };
  }

  if (event.httpMethod !== 'POST') {
    return {
      statusCode: 405,
      headers: corsHeaders,
      body: JSON.stringify({ error: 'Method Not Allowed' })
    };
  }

  // Client IP Rate Limiting
  const clientIp = (event.headers && (
    event.headers['x-nf-client-connection-ip'] ||
    event.headers['client-ip'] ||
    event.headers['x-forwarded-for']
  )) || 'anonymous';

  if (isRateLimited(clientIp)) {
    return {
      statusCode: 429,
      headers: corsHeaders,
      body: JSON.stringify({ error: 'Rate limit exceeded. Please wait a minute before sending another message.' })
    };
  }

  // Payload size limit (8KB max)
  if (event.body && event.body.length > 8192) {
    return {
      statusCode: 413,
      headers: corsHeaders,
      body: JSON.stringify({ error: 'Payload too large' })
    };
  }

  try {
    if (!event.body) {
      return {
        statusCode: 400,
        headers: corsHeaders,
        body: JSON.stringify({ error: 'Missing request body' })
      };
    }

    let body;
    try {
      body = JSON.parse(event.body);
    } catch (e) {
      return {
        statusCode: 400,
        headers: corsHeaders,
        body: JSON.stringify({ error: 'Invalid JSON payload' })
      };
    }

    const { messages } = body;
    if (!Array.isArray(messages) || messages.length === 0) {
      return {
        statusCode: 400,
        headers: corsHeaders,
        body: JSON.stringify({ error: 'Valid messages array is required' })
      };
    }

    const lastUserMessage = messages.filter(m => m.role === 'user').pop();
    const userQuery = lastUserMessage ? String(lastUserMessage.content || '').substring(0, 1000) : '';

    const geminiKey = process.env.GEMINI_API_KEY;
    const openrouterKey = process.env.OPENROUTER_API_KEY;
    const freellmUrl = process.env.FREELLM_API_URL;
    const freellmToken = process.env.FREELLM_API_TOKEN;
    const freellmModel = process.env.FREELLM_MODEL || 'auto';

    let reply = "";

    const llmHistory = messages.slice(-6).map(m => ({
      role: m.role === 'assistant' ? 'assistant' : 'user',
      content: String(m.content || '').substring(0, 1000)
    }));

    const formattedMessages = [
      { role: 'system', content: SYSTEM_PROMPT },
      ...llmHistory
    ];

    // Priority 1: Direct Google Gemini 2.5 Flash (100% Free Tier, sub-2s latency, ultra-smart)
    if (!reply && geminiKey && geminiKey.startsWith('AIzaSy')) {
      try {
        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 6500);

        const geminiContents = llmHistory.map(m => ({
          role: m.role === 'assistant' ? 'model' : 'user',
          parts: [{ text: m.content }]
        }));
        if (geminiContents.length === 0 || geminiContents[0].role !== 'user') {
          geminiContents.unshift({ role: 'user', parts: [{ text: userQuery || 'Hello' }] });
        }

        const geminiRes = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${geminiKey}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            system_instruction: { parts: [{ text: SYSTEM_PROMPT }] },
            contents: geminiContents,
            generationConfig: {
              maxOutputTokens: 600,
              temperature: 0.7,
              thinkingConfig: { thinkingBudget: 0 }
            }
          }),
          signal: controller.signal
        });
        clearTimeout(timeoutId);

        if (geminiRes.ok) {
          const data = await geminiRes.json();
          if (data.candidates && data.candidates[0] && data.candidates[0].content && data.candidates[0].content.parts) {
            reply = sanitizeLlmReply(data.candidates[0].content.parts[0].text || "");
          }
        }
      } catch (e) {
        // Fallback to OpenRouter
      }
    }

    // Priority 2: Direct OpenRouter 100% Free Models (:free, $0.00 cost)
    if (!reply && openrouterKey && openrouterKey.startsWith('sk-or-')) {
      const openRouterFreeModels = [
        "nvidia/nemotron-3-ultra-550b-a55b:free",
        "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free",
        "cohere/north-mini-code:free",
        "mistralai/mistral-small-24b-instruct-2501:free"
      ];
      if (process.env.AI_MODEL && !openRouterFreeModels.includes(process.env.AI_MODEL)) {
        openRouterFreeModels.push(process.env.AI_MODEL);
      }

      const fetchBody = {
        models: openRouterFreeModels,
        messages: formattedMessages,
        max_tokens: 500,
        temperature: 0.7
      };

      try {
        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 6500);

        const response = await fetch('https://openrouter.ai/api/v1/chat/completions', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${openrouterKey}`,
            'HTTP-Referer': 'https://dromber.site',
            'X-Title': 'Dromber Store'
          },
          body: JSON.stringify(fetchBody),
          signal: controller.signal
        });

        clearTimeout(timeoutId);

        if (response.ok) {
          const data = await response.json();
          if (data.choices && data.choices[0] && data.choices[0].message) {
            reply = sanitizeLlmReply(data.choices[0].message.content || "");
          }
        }
      } catch (e) {
        // Fallback to FreeLLMAPI
      }
    }

    // Priority 3: FreeLLMAPI Gateway (if configured e.g. remote or tunnel gateway)
    if (!reply && freellmUrl) {
      try {
        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 3500);

        const headers = { 'Content-Type': 'application/json' };
        if (freellmToken) headers['Authorization'] = `Bearer ${freellmToken}`;

        const response = await fetch(freellmUrl, {
          method: 'POST',
          headers: headers,
          body: JSON.stringify({
            model: freellmModel,
            messages: formattedMessages,
            max_tokens: 450,
            temperature: 0.7
          }),
          signal: controller.signal
        });

        clearTimeout(timeoutId);

        if (response.ok) {
          const data = await response.json();
          if (data.choices && data.choices[0] && data.choices[0].message) {
            reply = sanitizeLlmReply(data.choices[0].message.content || "");
          }
        }
      } catch (e) {
        // Fallback to deterministic domain engine
      }
    }

    // High-IQ Domain Knowledge Engine Fallback (guarantees instant, zero-cost, accurate answer)
    if (!reply) {
      reply = evaluateSeronQuery(userQuery);
    }

    return {
      statusCode: 200,
      headers: corsHeaders,
      body: JSON.stringify({
        choices: [{ message: { content: reply } }]
      })
    };

  } catch (err) {
    // Top-level defense: even on unexpected error, evaluate query rather than returning 500
    const fallbackReply = evaluateSeronQuery('');
    return {
      statusCode: 200,
      headers: corsHeaders,
      body: JSON.stringify({
        choices: [{ message: { content: fallbackReply } }]
      })
    };
  }
};

